{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ping.Api - port 5200",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/PingSignalR/src/Ping.Api/bin/Debug/net10.0/Ping.Api.dll",
      "cwd": "${workspaceFolder}/PingSignalR/src/Ping.Api",
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_URLS": "http://localhost:5200"
      },
      "stopAtEntry": false
    },
    {
      "name": "Ping.Client - Echo",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/PingSignalR/src/Ping.Client/bin/Debug/net10.0/Ping.Client.dll",
      "cwd": "${workspaceFolder}/PingSignalR/src/Ping.Client",
      "args": [
        "http://localhost:5200",
        "--auto-exit"
      ],
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Submission.RealtimeApi - port 5000",
