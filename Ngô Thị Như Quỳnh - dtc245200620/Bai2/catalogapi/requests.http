
@api = http://localhost:5100

### 1. Kiem tra server - 200
GET {{api}}/

### 2. Danh sach san pham - 200
GET {{api}}/api/products

### 3. Chi tiet san pham - 200
GET {{api}}/api/products/1

### 4. San pham khong ton tai - 404
GET {{api}}/api/products/999

### 5. ID khong hop le - 404
GET {{api}}/api/products/abc

### 6. Them san pham hop le - 201
POST {{api}}/api/products
Content-Type: application/json

{
  "name": "Lap trinh gRPC",
  "description": "Tai lieu bai 5",
  "price": 80000
}

### 7. Them san pham sai - 400
POST {{api}}/api/products
Content-Type: application/json

{
  "name": "San pham loi",
  "description": "",
  "price": -1
}

### 8. Thieu Content-Type - 415
POST {{api}}/api/products

{
  "name": "Lap trinh gRPC",
  "description": "Tai lieu bai 5",
  "price": 80000
}
